# Required by compose files
VNC_PASSWORD=change-me

# Session users
XRDP_USERNAME=abc
XRDP_XORG_USERNAME=app

# Persistent config
CHROMIUM_CONFIG_DIR=./chromium-xrdp-xorg-config

# Session behavior
GUI_IDLE_TIMEOUT=60
CHROMIUM_DEBUG=0

# Optional Chromium settings
CHROMIUM_APP_URL=
CHROMIUM_CUSTOM_ARGS=
CHROMIUM_REMOTE_DEBUGGING=0
CHROMIUM_REMOTE_DEBUGGING_PORT=9222
