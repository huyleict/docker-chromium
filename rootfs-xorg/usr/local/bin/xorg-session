#!/bin/sh
set -eu

SESSION_USER=${USER:-$(id -un)}
PROFILE_DIR=/config/chromium-xorg-$SESSION_USER
LOG_DIR=/config/log/chromium-xorg-$SESSION_USER
export XDG_CONFIG_HOME="$PROFILE_DIR/config"
export XDG_CACHE_HOME="$PROFILE_DIR/cache"
mkdir -p "$PROFILE_DIR/Crash Reports" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$LOG_DIR"
rm -f "$PROFILE_DIR"/SingletonLock "$PROFILE_DIR"/SingletonCookie "$PROFILE_DIR"/SingletonSocket
if [ -d /config/.config/fcitx5 ]; then
    mkdir -p "$XDG_CONFIG_HOME/fcitx5"
    cp -R /config/.config/fcitx5/. "$XDG_CONFIG_HOME/fcitx5/"
fi

fcitx5 -D --replace >/dev/null 2>&1 &
FCITX_PID=$!
sleep 2

FCITX_ENV=$(tr '\0' '\n' < /proc/$FCITX_PID/environ 2>/dev/null |
    grep -E '^(DBUS_SESSION_BUS_ADDRESS|DISPLAY|XDG_RUNTIME_DIR)=' || true)
eval "$(printf '%s\n' "$FCITX_ENV" | sed 's/^/export /')"
fcitx5-remote -s unikey >/dev/null 2>&1 || true

set -- \
    --no-first-run \
    --no-default-browser-check \
    --no-sandbox \
    --disable-dev-shm-usage \
    --ignore-gpu-blocklist \
    "--simulate-outdated-no-au=Tue, 31 Dec 2099 23:59:59 GMT" \
    --start-maximized \
    "--user-data-dir=$PROFILE_DIR"

if [ -n "${CHROMIUM_APP_URL:-}" ]; then
    set -- "$@" "--app=$CHROMIUM_APP_URL"
fi
case "${CHROMIUM_REMOTE_DEBUGGING:-0}" in
    1|true|TRUE|yes|YES)
        set -- "$@" "--remote-debugging-port=$((${CHROMIUM_REMOTE_DEBUGGING_PORT:-9222} + 1))"
        ;;
esac
if [ -n "${CHROMIUM_CUSTOM_ARGS:-}" ]; then
    eval "set -- \"\$@\" $CHROMIUM_CUSTOM_ARGS"
fi

/usr/bin/chromium-browser "$@" >>"$LOG_DIR/output.log" 2>>"$LOG_DIR/error.log" &
CHROMIUM_PID=$!
sleep 1
wait "$CHROMIUM_PID"
