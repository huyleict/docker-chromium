#!/bin/sh

set -eu

TIMEOUT=${GUI_IDLE_TIMEOUT:-60}
INTERVAL=30
IDLE=0

has_clients() {
    awk '$4 == "01" && ($2 ~ /:0D3D$/ || $2 ~ /:170C$/ || $2 ~ /:16A8$/) { found=1 } END { exit !found }' /proc/net/tcp /proc/net/tcp6
}

while :; do
    if has_clients; then
        IDLE=0
    else
        IDLE=$((IDLE + INTERVAL))
        if [ "$IDLE" -ge "$TIMEOUT" ]; then
            pkill -TERM -u app -f '/usr/lib/chromium/chromium' || true
            pkill -TERM -u app -x fcitx5 || true
            IDLE=0
        fi
    fi
    sleep "$INTERVAL"
done
